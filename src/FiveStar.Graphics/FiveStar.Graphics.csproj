<Project Sdk="Microsoft.NET.Sdk">
  <!-- D3D12 runtime core: adapters, devices, the root-signature layout of translated programs, the DXIL form each
       adapter runs and pipeline states. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Part of fivestar-loader: trim and AOT analysis on every build (docs/aot.md). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- MeshWaveProbe: built from Probes/mesh_wave_probe.hlsl with the dxc line in its header. -->
    <EmbeddedResource Include="Probes/mesh_wave_probe.dxil" LogicalName="FiveStar.Graphics.Probes.mesh_wave_probe.dxil" />
    <None Include="Probes/mesh_wave_probe.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D12" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
</Project>
