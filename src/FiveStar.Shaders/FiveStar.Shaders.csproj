<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shader containers (SGD5, DXBC, XDAT, FSSM), the RDNA disassembly driver and the RDNA to HLSL translator. -->
  <PropertyGroup>
    <!-- Part of fivestar-loader: trim and AOT analysis on every build (docs/aot.md). -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- DxcLibraryCompiler and the DXIL validator wrapper call DXC and dxil.dll through COM vtables. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The loader's program cache is keyed by a hash of this assembly's bytes (docs/d3d12x-pipelines.md). With the
      commit id in the informational version every commit started an empty cache, so programs stay keyed by code only.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveStar.Shaders.Tests" />
  </ItemGroup>

  <!-- HLSL runtime helpers included by every translated program; written next to the generated HLSL. -->
  <ItemGroup>
    <EmbeddedResource Include="Translation\Runtime\*.hlsli" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
